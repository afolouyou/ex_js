        ,
    },
    .{
        .source =
        \\var x = 0;
        \\try {
        \\  throw 1;
        \\} catch (e) {
        \\  x += e;
        \\}
        \\try {
        \\  x += 2;
        \\} finally {
        \\  x += 3;
        \\}
        \\try {
        \\  throw 4;
        \\} catch (e) {
        \\  x += e;
        \\} finally {
        \\  x += 5;
        \\}
        \\x;
        \\
        ,
