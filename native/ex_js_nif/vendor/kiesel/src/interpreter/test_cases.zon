        \\  %2: [  2..4  ]                       call %1, %0, []
        \\  %3: [  3..4  ]                       number 1
        \\  %4: [  4..5  ]                       add %2, %3
        \\  %5: [  5..5  ]                       return %4
        \\  %6: [  6..6  ] dead                  return none
