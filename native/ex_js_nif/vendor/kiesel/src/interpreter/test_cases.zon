    // For-in/of statement
    .{
        .source =
        \\var sum = 0;
        \\for (var x of [1, 2, 3]) {
        \\  sum = sum + x;
        \\}
        \\sum;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 6 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       number 0
        \\  %1: [  1..1  ]                       set_binding @0 ("sum"), %0
        \\  %2: [  2..11 ]                       undefined
        \\  %3: [  3..10 ]                       create_array 3
        \\  %4: [  4..5  ]                       number 1
        \\  %5: [  5..5  ]                       array_push %3, %4
        \\  %6: [  6..7  ]                       number 2
        \\  %7: [  7..7  ]                       array_push %3, %6
        \\  %8: [  8..9  ]                       number 3
        \\  %9: [  9..9  ]                       array_push %3, %8
        \\ %10: [ 10..23 ]                       get_iterator %3
        \\ %11: [ 11..11 ]                       br %12, %2
        \\ %12: [ 12..25 ]                       label
        \\ %13: [ 13..18 ]                       iterator_step_value %10
        \\ %14: [ 14..15 ]                       iterator_is_done %10
        \\ %15: [ 15..16 ]                       logical_not %14
        \\ %16: [ 16..16 ]                       br_cond %15, %17, %24
        \\ %17: [ 17..17 ]                       label
        \\ %18: [ 18..18 ]                       set_binding @1 ("x"), %13
        \\ %19: [ 19..21 ]                       get_binding @0 ("sum")
        \\ %20: [ 20..21 ]                       get_binding @1 ("x")
        \\ %21: [ 21..22 ]                       add %19, %20
        \\ %22: [ 22..23 ]                       set_binding @0 ("sum"), %21
        \\ %23: [ 23..23 ]                       br %12, %22
        \\ %24: [ 24..24 ]                       label
        \\ %25: [ 25..25 ]                       br %26, %12
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..28 ]                       get_binding @0 ("sum")
        \\ %28: [ 28..28 ]                       return %27
        \\
        \\Bytecode (test)
        \\   0: 07 00 00 00                      load_number_i8 r0, 0
        \\   4: 50 00 00 00 00 00 00             set_binding @0 ("sum"), r0
        \\  11: 03 00 00                         load_undefined r0
        \\  14: 0d 01 00 03 00 00 00             create_array r1, 3
        \\  21: 07 02 00 01                      load_number_i8 r2, 1
        \\  25: 10 01 00 02 00 00 00 00 00       array_set r1, r2, 0
        \\  34: 07 02 00 02                      load_number_i8 r2, 2
        \\  38: 10 01 00 02 00 01 00 00 00       array_set r1, r2, 1
        \\  47: 07 02 00 03                      load_number_i8 r2, 3
        \\  51: 10 01 00 02 00 02 00 00 00       array_set r1, r2, 2
        \\  60: 6f 02 00 01 00                   get_iterator r2, r1
        \\  65: 73 01 00 02 00                   iterator_step_value r1, r2
        \\  70: 76 03 00 02 00                   iterator_is_done r3, r2
        \\  75: 26 04 00 03 00                   logical_not r4, r3
        \\  80: 01 04 00 05 00 00 00             jump_if_true r4, 5
        \\  87: 00 32 00 00 00                   jump 50
        \\  92: 50 01 00 00 00 01 00             set_binding @1 ("x"), r1
        \\  99: 4b 01 00 00 00 00 00             get_binding r1, @0 ("sum")
        \\ 106: 4b 03 00 01 00 00 00             get_binding r3, @1 ("x")
        \\ 113: 2b 04 00 01 00 03 00             add r4, r1, r3
        \\ 120: 50 00 00 00 00 04 00             set_binding @0 ("sum"), r4
        \\ 127: 0c 01 00 04 00                   move r1, r4
        \\ 132: 0c 00 00 01 00                   move r0, r1
        \\ 137: 00 b3 ff ff ff                   jump -77
        \\ 142: 4b 00 00 00 00 00 00             get_binding r0, @0 ("sum")
        \\ 149: 7a 00 00                         return r0
        \\
        ,
    },

    // For-in/of with member expression LHS
    .{
        .source =
        \\var x = {};
        \\for (x.last in {a: 1, b: 2, c: 3});
        \\x.last;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "c" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       create_object 0
        \\  %1: [  1..1  ]                       set_binding @0 ("x"), %0
        \\  %2: [  2..27 ]                       undefined
        \\  %3: [  3..13 ]                       create_object 3
        \\  %4: [  4..5  ]                       number 1
        \\  %5: [  5..5  ]                       object_set %3, @1 ("a"), %4
        \\  %6: [  6..7  ]                       number 2
        \\  %7: [  7..7  ]                       object_set %3, @2 ("b"), %6
        \\  %8: [  8..9  ]                       number 3
        \\  %9: [  9..9  ]                       object_set %3, @3 ("c"), %8
        \\ %10: [ 10..11 ]                       is_nullish %3
        \\ %11: [ 11..11 ]                       br_cond %10, %26, %12
        \\ %12: [ 12..12 ]                       label
        \\ %13: [ 13..23 ]                       get_for_in_iterator %3
        \\ %14: [ 14..14 ]                       br %15, %2
        \\ %15: [ 15..25 ]                       label
        \\ %16: [ 16..22 ]                       iterator_step_value %13
        \\ %17: [ 17..18 ]                       iterator_is_done %13
        \\ %18: [ 18..19 ]                       logical_not %17
        \\ %19: [ 19..19 ]                       br_cond %18, %20, %24
        \\ %20: [ 20..20 ]                       label
        \\ %21: [ 21..22 ]                       get_binding @0 ("x")
        \\ %22: [ 22..22 ]                       set_property %21, @4 ("last"), %16
        \\ %23: [ 23..23 ]                       br %15, %2
        \\ %24: [ 24..24 ]                       label
        \\ %25: [ 25..25 ]                       br %28, %15
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..27 ]                       br %28, %2
        \\ %28: [ 28..28 ]                       label
        \\ %29: [ 29..30 ]                       get_binding @0 ("x")
        \\ %30: [ 30..31 ]                       get_property %29, @4 ("last")
        \\ %31: [ 31..31 ]                       return %30
        \\
        \\Bytecode (test)
        \\   0: 12 00 00 00 00 00 00             create_object r0, 0
        \\   7: 50 00 00 00 00 00 00             set_binding @0 ("x"), r0
        \\  14: 03 00 00                         load_undefined r0
        \\  17: 12 01 00 03 00 00 00             create_object r1, 3
        \\  24: 07 02 00 01                      load_number_i8 r2, 1
        \\  28: 13 01 00 01 00 00 00 02 00       object_set r1, @1 ("a"), r2
        \\  37: 07 02 00 02                      load_number_i8 r2, 2
        \\  41: 13 01 00 02 00 00 00 02 00       object_set r1, @2 ("b"), r2
        \\  50: 07 02 00 03                      load_number_i8 r2, 3
        \\  54: 13 01 00 03 00 00 00 02 00       object_set r1, @3 ("c"), r2
        \\  63: 27 02 00 01 00                   is_nullish r2, r1
        \\  68: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  75: 00 05 00 00 00                   jump 5
        \\  80: 00 41 00 00 00                   jump 65
        \\  85: 71 02 00 01 00                   get_for_in_iterator r2, r1
        \\  90: 0c 01 00 00 00                   move r1, r0
        \\  95: 73 03 00 02 00                   iterator_step_value r3, r2
        \\ 100: 76 04 00 02 00                   iterator_is_done r4, r2
        \\ 105: 26 05 00 04 00                   logical_not r5, r4
        \\ 110: 01 05 00 05 00 00 00             jump_if_true r5, 5
        \\ 117: 00 1c 00 00 00                   jump 28
        \\ 122: 4b 04 00 00 00 00 00             get_binding r4, @0 ("x")
        \\ 129: 52 04 00 03 00 04 00 00 00 00 00 set_property r4, r3, @4 ("last"), @0
        \\ 140: 0c 01 00 00 00                   move r1, r0
        \\ 145: 00 c9 ff ff ff                   jump -55
        \\ 150: 4b 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\ 157: 4c 01 00 00 00 04 00 00 00 00 00 get_property r1, r0, @4 ("last"), @0
        \\ 168: 7a 01 00                         return r1
        \\
        ,
    },

    // With statement
    .{
        .source =
        \\var o = {x: 1};
        \\with (o) { x }
        \\
        ,
        .expected_result = .{ .value = .{ .number = 1 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..3  ]                       create_object 1
        \\  %1: [  1..2  ]                       number 1
        \\  %2: [  2..2  ]                       object_set %0, @0 ("x"), %1
        \\  %3: [  3..3  ]                       set_binding @1 ("o"), %0
        \\  %4: [  4..5  ]                       get_binding @1 ("o")
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..6  ]                       push_with_scope %5
        \\  %7: [  7..9  ]                       get_binding @0 ("x")
        \\  %8: [  8..8  ]                       pop_scope
        \\  %9: [  9..9  ]                       return %7
        \\
        \\Bytecode (test)
        \\   0: 12 00 00 01 00 00 00             create_object r0, 1
        \\   7: 07 01 00 01                      load_number_i8 r1, 1
        \\  11: 13 00 00 00 00 00 00 01 00       object_set r0, @0 ("x"), r1
        \\  20: 50 01 00 00 00 00 00             set_binding @1 ("o"), r0
        \\  27: 4b 00 00 01 00 00 00             get_binding r0, @1 ("o")
        \\  34: 21 01 00 00 00                   to_object r1, r0
        \\  39: 44 01 00                         push_with_scope r1
        \\  42: 4b 00 00 00 00 00 00             get_binding r0, @0 ("x")
        \\  49: 45                               pop_scope
        \\  50: 7a 00 00                         return r0
        \\
        ,
    },

    // Optional expression
    .{
        .source =
        \\var o = {a: {b: 123}};
        \\o.x?.y ?? o.a?.["b"];
        \\
        ,
        .expected_result = .{ .value = .{ .number = 123 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..5  ]                       create_object 1
        \\  %1: [  1..4  ]                       create_object 1
        \\  %2: [  2..3  ]                       number 123
        \\  %3: [  3..3  ]                       object_set %1, @1 ("b"), %2
        \\  %4: [  4..4  ]                       object_set %0, @0 ("a"), %1
        \\  %5: [  5..5  ]                       set_binding @2 ("o"), %0
        \\  %6: [  6..7  ]                       get_binding @2 ("o")
        \\  %7: [  7..11 ]                       get_property %6, @3 ("x")
        \\  %8: [  8..9  ]                       is_nullish %7
        \\  %9: [  9..9  ]                       br_cond %8, %13, %10
        \\ %10: [ 10..10 ]                       label
        \\ %11: [ 11..12 ]                       get_property %7, @4 ("y")
        \\ %12: [ 12..12 ]                       br %16, %11
        \\ %13: [ 13..13 ]                       label
        \\ %14: [ 14..15 ]                       undefined
        \\ %15: [ 15..15 ]                       br %16, %14
        \\ %16: [ 16..20 ]                       label
        \\ %17: [ 17..18 ]                       is_nullish %16
        \\ %18: [ 18..18 ]                       br_cond %17, %21, %19
        \\ %19: [ 19..19 ]                       label
        \\ %20: [ 20..20 ]                       br %34, %16
        \\ %21: [ 21..21 ]                       label
        \\ %22: [ 22..23 ]                       get_binding @2 ("o")
        \\ %23: [ 23..27 ]                       get_property %22, @0 ("a")
        \\ %24: [ 24..25 ]                       is_nullish %23
        \\ %25: [ 25..25 ]                       br_cond %24, %29, %26
        \\ %26: [ 26..26 ]                       label
        \\ %27: [ 27..28 ]                       get_property %23, @1 ("b")
        \\ %28: [ 28..28 ]                       br %32, %27
        \\ %29: [ 29..29 ]                       label
        \\ %30: [ 30..31 ]                       undefined
        \\ %31: [ 31..31 ]                       br %32, %30
        \\ %32: [ 32..33 ]                       label
        \\ %33: [ 33..33 ]                       br %34, %32
        \\ %34: [ 34..35 ]                       label
        \\ %35: [ 35..35 ]                       return %34
        \\
        \\Bytecode (test)
        \\   0: 12 00 00 01 00 00 00             create_object r0, 1
        \\   7: 12 01 00 01 00 00 00             create_object r1, 1
        \\  14: 07 02 00 7b                      load_number_i8 r2, 123
        \\  18: 13 01 00 01 00 00 00 02 00       object_set r1, @1 ("b"), r2
        \\  27: 13 00 00 00 00 00 00 01 00       object_set r0, @0 ("a"), r1
        \\  36: 50 02 00 00 00 00 00             set_binding @2 ("o"), r0
        \\  43: 4b 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\  50: 4c 01 00 00 00 03 00 00 00 00 00 get_property r1, r0, @3 ("x"), @0
        \\  61: 27 00 00 01 00                   is_nullish r0, r1
        \\  66: 01 00 00 05 00 00 00             jump_if_true r0, 5
        \\  73: 00 08 00 00 00                   jump 8
        \\  78: 03 00 00                         load_undefined r0
        \\  81: 00 0b 00 00 00                   jump 11
        \\  86: 4c 00 00 01 00 04 00 00 00 01 00 get_property r0, r1, @4 ("y"), @1
        \\  97: 27 01 00 00 00                   is_nullish r1, r0
        \\ 102: 01 01 00 05 00 00 00             jump_if_true r1, 5
        \\ 109: 00 3b 00 00 00                   jump 59
        \\ 114: 4b 00 00 02 00 00 00             get_binding r0, @2 ("o")
        \\ 121: 4c 01 00 00 00 00 00 00 00 02 00 get_property r1, r0, @0 ("a"), @2
        \\ 132: 27 00 00 01 00                   is_nullish r0, r1
        \\ 137: 01 00 00 05 00 00 00             jump_if_true r0, 5
        \\ 144: 00 08 00 00 00                   jump 8
        \\ 149: 03 00 00                         load_undefined r0
        \\ 152: 00 0b 00 00 00                   jump 11
        \\ 157: 4c 00 00 01 00 01 00 00 00 03 00 get_property r0, r1, @1 ("b"), @3
        \\ 168: 00 00 00 00 00                   jump 0
        \\ 173: 7a 00 00                         return r0
        \\
        ,
    },

    // Template literal
    .{
        .source =
        \\var empty = ``;
        \\`${empty}a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       string @0 ("")
        \\  %1: [  1..1  ]                       set_binding @1 ("empty"), %0
        \\  %2: [  2..3  ]                       get_binding @1 ("empty")
        \\  %3: [  3..5  ]                       to_string %2
        \\  %4: [  4..5  ]                       string @2 ("a")
        \\  %5: [  5..7  ]                       add %3, %4
        \\  %6: [  6..7  ]                       string @3 ("b")
        \\  %7: [  7..9  ]                       add %5, %6
        \\  %8: [  8..9  ]                       string @4 ("c")
        \\  %9: [  9..10 ]                       add %7, %8
        \\ %10: [ 10..10 ]                       return %9
        \\
        \\Bytecode (test)
        \\   0: 0a 00 00 00 00 00 00             load_string r0, @0 ("")
        \\   7: 50 01 00 00 00 00 00             set_binding @1 ("empty"), r0
        \\  14: 4b 00 00 01 00 00 00             get_binding r0, @1 ("empty")
        \\  21: 20 01 00 00 00                   to_string r1, r0
        \\  26: 0a 00 00 02 00 00 00             load_string r0, @2 ("a")
        \\  33: 2b 02 00 01 00 00 00             add r2, r1, r0
        \\  40: 0a 00 00 03 00 00 00             load_string r0, @3 ("b")
        \\  47: 2b 01 00 02 00 00 00             add r1, r2, r0
        \\  54: 0a 00 00 04 00 00 00             load_string r0, @4 ("c")
        \\  61: 2b 02 00 01 00 00 00             add r2, r1, r0
        \\  68: 7a 02 00                         return r2
        \\
        ,
    },

    // Tagged template
    .{
        .source =
        \\String.raw`a${"b"}c`;
        \\
        ,
        .expected_result = .{ .value = .{ .string = "abc" } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..14 ]                       get_binding @0 ("String")
        \\  %1: [  1..14 ]                       get_property %0, @1 ("raw")
        \\  %2: [  2..12 ]                       create_array 2
        \\  %3: [  3..4  ]                       string @2 ("a")
        \\  %4: [  4..4  ]                       array_push %2, %3
        \\  %5: [  5..6  ]                       string @3 ("c")
        \\  %6: [  6..6  ]                       array_push %2, %5
        \\  %7: [  7..12 ]                       create_array 2
        \\  %8: [  8..9  ]                       string @2 ("a")
        \\  %9: [  9..9  ]                       array_push %7, %8
        \\ %10: [ 10..11 ]                       string @3 ("c")
        \\ %11: [ 11..11 ]                       array_push %7, %10
        \\ %12: [ 12..14 ]                       get_template_object %2, %7, 0
        \\ %13: [ 13..14 ]                       string @4 ("b")
        \\ %14: [ 14..15 ]                       call %1, %0, [%12, %13]
        \\ %15: [ 15..15 ]                       return %14
        \\
        \\Bytecode (test)
        \\   0: 4b 00 00 00 00 00 00             get_binding r0, @0 ("String")
        \\   7: 4c 01 00 00 00 01 00 00 00 00 00 get_property r1, r0, @1 ("raw"), @0
        \\  18: 0d 02 00 02 00 00 00             create_array r2, 2
        \\  25: 0a 03 00 02 00 00 00             load_string r3, @2 ("a")
        \\  32: 10 02 00 03 00 00 00 00 00       array_set r2, r3, 0
        \\  41: 0a 03 00 03 00 00 00             load_string r3, @3 ("c")
        \\  48: 10 02 00 03 00 01 00 00 00       array_set r2, r3, 1
        \\  57: 0d 03 00 02 00 00 00             create_array r3, 2
        \\  64: 0a 04 00 02 00 00 00             load_string r4, @2 ("a")
        \\  71: 10 03 00 04 00 00 00 00 00       array_set r3, r4, 0
        \\  80: 0a 04 00 03 00 00 00             load_string r4, @3 ("c")
        \\  87: 10 03 00 04 00 01 00 00 00       array_set r3, r4, 1
        \\  96: 6e 04 00 02 00 03 00 00 00       get_template_object r4, r2, r3, 0
        \\ 105: 0a 02 00 04 00 00 00             load_string r2, @4 ("b")
        \\ 112: 67 03 00 01 00 00 00 04 00 02 00 call_property2 r3, r1, r0, r4, r2
        \\ 123: 7a 03 00                         return r3
        \\
        ,
    },

    // Functions
    .{
        .source =
        \\var f = ({a}, b = 0, ...rest) => a + b + rest.length;
        \\f({a: 1}, 2, 3, 4);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 5 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       create_function @0
        \\  %1: [  1..1  ]                       set_binding @0 ("f"), %0
        \\  %2: [  2..9  ]                       get_binding @0 ("f")
        \\  %3: [  3..9  ]                       create_object 1
        \\  %4: [  4..5  ]                       number 1
        \\  %5: [  5..5  ]                       object_set %3, @1 ("a"), %4
        \\  %6: [  6..9  ]                       number 2
        \\  %7: [  7..9  ]                       number 3
        \\  %8: [  8..9  ]                       number 4
        \\  %9: [  9..10 ]                       call %2, none, [%3, %6, %7, %8]
        \\ %10: [ 10..10 ]                       return %9
        \\
        \\Bytecode (test)
        \\   0: 7e 00 00 00 00                   create_function r0, @0
        \\   5: 50 00 00 00 00 00 00             set_binding @0 ("f"), r0
        \\  12: 4b 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\  19: 12 01 00 01 00 00 00             create_object r1, 1
        \\  26: 07 02 00 01                      load_number_i8 r2, 1
        \\  30: 13 01 00 01 00 00 00 02 00       object_set r1, @1 ("a"), r2
        \\  39: 07 02 00 02                      load_number_i8 r2, 2
        \\  43: 07 03 00 03                      load_number_i8 r3, 3
        \\  47: 07 04 00 04                      load_number_i8 r4, 4
        \\  51: 0d 06 00 00 00 00 00             create_array r6, 0
        \\  58: 0e 06 00 01 00                   array_push r6, r1
        \\  63: 0e 06 00 02 00                   array_push r6, r2
        \\  68: 0e 06 00 03 00                   array_push r6, r3
        \\  73: 0e 06 00 04 00                   array_push r6, r4
        \\  78: 60 05 00 00 00 06 00             call r5, r0, r6
        \\  85: 7a 05 00                         return r5
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       create_mutable_binding @0 ("a")
        \\  %2: [  2..2  ]                       create_mutable_binding @1 ("b")
        \\  %3: [  3..3  ]                       create_mutable_binding @2 ("rest")
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..6  ]                       to_object %4
        \\  %6: [  6..7  ]                       get_property %5, @0 ("a")
        \\  %7: [  7..7  ]                       initialize_binding @0 ("a"), %6
        \\  %8: [  8..16 ]                       get_argument 1
        \\  %9: [  9..10 ]                       undefined
        \\ %10: [ 10..11 ]                       eq_strict %8, %9
        \\ %11: [ 11..11 ]                       br_cond %10, %12, %15
        \\ %12: [ 12..12 ]                       label
        \\ %13: [ 13..14 ]                       number 0
        \\ %14: [ 14..14 ]                       br %17, %13
        \\ %15: [ 15..15 ]                       label
        \\ %16: [ 16..16 ]                       br %17, %8
        \\ %17: [ 17..18 ]                       label
        \\ %18: [ 18..18 ]                       initialize_binding @1 ("b"), %17
        \\ %19: [ 19..20 ]                       get_rest_arguments 2
        \\ %20: [ 20..20 ]                       initialize_binding @2 ("rest"), %19
        \\ %21: [ 21..21 ]                       push_var_scope
        \\ %22: [ 22..22 ]                       push_scope
        \\ %23: [ 23..25 ]                       get_binding @0 ("a")
        \\ %24: [ 24..25 ]                       get_binding @1 ("b")
        \\ %25: [ 25..28 ]                       add %23, %24
        \\ %26: [ 26..27 ]                       get_binding @2 ("rest")
        \\ %27: [ 27..28 ]                       get_property %26, @3 ("length")
        \\ %28: [ 28..29 ]                       add %25, %27
        \\ %29: [ 29..29 ]                       return %28
        \\ %30: [ 30..30 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 42                               push_scope
        \\   1: 47 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   6: 47 01 00 00 00                   create_mutable_binding @1 ("b")
        \\  11: 47 02 00 00 00                   create_mutable_binding @2 ("rest")
        \\  16: 83 00 00 00 00                   get_argument r0, 0
        \\  21: 21 01 00 00 00                   to_object r1, r0
        \\  26: 4c 00 00 01 00 00 00 00 00 00 00 get_property r0, r1, @0 ("a"), @0
        \\  37: 49 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  44: 83 00 00 01 00                   get_argument r0, 1
        \\  49: 03 01 00                         load_undefined r1
        \\  52: 3f 02 00 00 00 01 00             eq_strict r2, r0, r1
        \\  59: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  66: 00 0e 00 00 00                   jump 14
        \\  71: 07 01 00 00                      load_number_i8 r1, 0
        \\  75: 0c 00 00 01 00                   move r0, r1
        \\  80: 00 00 00 00 00                   jump 0
        \\  85: 49 01 00 00 00 00 00             initialize_binding @1 ("b"), r0
        \\  92: 84 00 00 02 00                   get_rest_arguments r0, 2
        \\  97: 49 02 00 00 00 00 00             initialize_binding @2 ("rest"), r0
        \\ 104: 43                               push_var_scope
        \\ 105: 42                               push_scope
        \\ 106: 4b 00 00 00 00 00 00             get_binding r0, @0 ("a")
        \\ 113: 4b 01 00 01 00 00 00             get_binding r1, @1 ("b")
        \\ 120: 2b 02 00 00 00 01 00             add r2, r0, r1
        \\ 127: 4b 00 00 02 00 00 00             get_binding r0, @2 ("rest")
        \\ 134: 4c 01 00 00 00 03 00 00 00 01 00 get_property r1, r0, @3 ("length"), @1
        \\ 145: 2b 00 00 02 00 01 00             add r0, r2, r1
        \\ 152: 7a 00 00                         return r0
        \\
        ,
    },

    // Arguments object
    .{
        .source =
        \\function mapped(a) {
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\function unmapped(a) {
        \\  "use strict";
        \\  a = 99;
        \\  return arguments[0];
        \\}
        \\mapped(1) - unmapped(1);
        \\
        ,
        .expected_result = .{ .value = .{ .number = 98 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..2  ]                       get_binding @0 ("mapped")
        \\  %1: [  1..2  ]                       number 1
        \\  %2: [  2..6  ]                       call %0, none, [%1]
        \\  %3: [  3..5  ]                       get_binding @1 ("unmapped")
        \\  %4: [  4..5  ]                       number 1
        \\  %5: [  5..6  ]                       call %3, none, [%4]
        \\  %6: [  6..7  ]                       sub %2, %5
        \\  %7: [  7..7  ]                       return %6
        \\
        \\Bytecode (test)
        \\   0: 4b 00 00 00 00 00 00             get_binding r0, @0 ("mapped")
        \\   7: 07 01 00 01                      load_number_i8 r1, 1
        \\  11: 62 02 00 00 00 01 00             call1 r2, r0, r1
        \\  18: 4b 00 00 01 00 00 00             get_binding r0, @1 ("unmapped")
        \\  25: 07 01 00 01                      load_number_i8 r1, 1
        \\  29: 62 03 00 00 00 01 00             call1 r3, r0, r1
        \\  36: 2c 00 00 02 00 03 00             sub r0, r2, r3
        \\  43: 7a 00 00                         return r0
        \\
        \\IR (mapped)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("a")
        \\  %1: [  1..3  ]                       create_mapped_arguments_object
        \\  %2: [  2..2  ]                       create_mutable_binding @1 ("arguments")
        \\  %3: [  3..3  ]                       initialize_binding @1 ("arguments"), %1
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ]                       push_scope
        \\  %7: [  7..8  ]                       number 99
        \\  %8: [  8..8  ]                       set_binding @0 ("a"), %7
        \\  %9: [  9..10 ]                       get_binding @1 ("arguments")
        \\ %10: [ 10..11 ]                       get_property_indexed %9, 0
        \\ %11: [ 11..11 ]                       return %10
        \\ %12: [ 12..12 ] dead                  return none
        \\
        \\Bytecode (mapped)
        \\   0: 47 00 00 00 00                   create_mutable_binding @0 ("a")
        \\   5: 82 00 00                         create_mapped_arguments_object r0
        \\   8: 47 01 00 00 00                   create_mutable_binding @1 ("arguments")
        \\  13: 49 01 00 00 00 00 00             initialize_binding @1 ("arguments"), r0
        \\  20: 83 00 00 00 00                   get_argument r0, 0
        \\  25: 49 00 00 00 00 00 00             initialize_binding @0 ("a"), r0
        \\  32: 42                               push_scope
        \\  33: 07 00 00 63                      load_number_i8 r0, 99
        \\  37: 50 00 00 00 00 00 00             set_binding @0 ("a"), r0
        \\  44: 4b 00 00 01 00 00 00             get_binding r0, @1 ("arguments")
        \\  51: 4e 01 00 00 00 00 00 00 00       get_property_indexed r1, r0, 0
        \\  60: 7a 01 00                         return r1
        \\
        \\IR (unmapped)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("a")
        \\  %1: [  1..3  ]                       create_unmapped_arguments_object
        \\  %2: [  2..2  ]                       create_immutable_binding @1 ("arguments")
        \\  %3: [  3..3  ]                       initialize_binding @1 ("arguments"), %1
        \\  %4: [  4..5  ]                       get_argument 0
        \\  %5: [  5..5  ]                       initialize_binding @0 ("a"), %4
        \\  %6: [  6..6  ] dead                  string @2 ("use strict")
        \\  %7: [  7..8  ]                       number 99
        \\  %8: [  8..8  ]                       set_binding_strict @0 ("a"), %7
        \\  %9: [  9..10 ]                       get_binding @1 ("arguments")
        \\ %10: [ 10..11 ]                       get_property_indexed %9, 0
        \\ %11: [ 11..11 ]                       return %10
        \\ %12: [ 12..12 ] dead                  return none
        \\
        \\Bytecode (unmapped)
        \\   0: 81 00 00                         create_unmapped_arguments_object r0
        \\   3: 4f 01 00 00 00                   set_local l1, r0
        \\   8: 83 00 00 00 00                   get_argument r0, 0
        \\  13: 4f 00 00 00 00                   set_local l0, r0
        \\  18: 07 00 00 63                      load_number_i8 r0, 99
        \\  22: 4f 00 00 00 00                   set_local l0, r0
        \\  27: 4a 00 00 01 00                   get_local r0, l1
        \\  32: 4e 01 00 00 00 00 00 00 00       get_property_indexed r1, r0, 0
        \\  41: 7a 01 00                         return r1
        \\
        ,
    },

    // Getter/setter
    .{
        .source =
        \\var o = {
        \\  get x() { return this._x; },
        \\  set x(v) { this._x = v; },
        \\};
        \\o.x = 42;
        \\o.x;
        \\
        ,
        .expected_result = .{ .value = .{ .number = 42 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..7  ]                       create_object 2
        \\  %1: [  1..2  ]                       create_function @0
        \\  %2: [  2..3  ]                       as_getter %1
        \\  %3: [  3..3  ]                       object_set %0, @0 ("x"), %2
        \\  %4: [  4..5  ]                       create_function @1
        \\  %5: [  5..6  ]                       as_setter %4
        \\  %6: [  6..6  ]                       object_set %0, @0 ("x"), %5
        \\  %7: [  7..7  ]                       set_binding @3 ("o"), %0
        \\  %8: [  8..10 ]                       get_binding @3 ("o")
        \\  %9: [  9..10 ]                       number 42
        \\ %10: [ 10..10 ]                       set_property %8, @0 ("x"), %9
        \\ %11: [ 11..12 ]                       get_binding @3 ("o")
        \\ %12: [ 12..13 ]                       get_property %11, @0 ("x")
        \\ %13: [ 13..13 ]                       return %12
        \\
        \\Bytecode (test)
        \\   0: 12 00 00 02 00 00 00             create_object r0, 2
        \\   7: 7e 01 00 00 00                   create_function r1, @0
        \\  12: 0c 02 00 01 00                   move r2, r1
        \\  17: 80 02 00 00 00                   set_home_object r2, r0
        \\  22: 15 00 00 00 00 00 00 02 00       object_set_getter r0, @0 ("x"), r2
        \\  31: 7e 01 00 01 00                   create_function r1, @1
        \\  36: 0c 02 00 01 00                   move r2, r1
        \\  41: 80 02 00 00 00                   set_home_object r2, r0
        \\  46: 17 00 00 00 00 00 00 02 00       object_set_setter r0, @0 ("x"), r2
        \\  55: 50 03 00 00 00 00 00             set_binding @3 ("o"), r0
        \\  62: 4b 00 00 03 00 00 00             get_binding r0, @3 ("o")
        \\  69: 07 01 00 2a                      load_number_i8 r1, 42
        \\  73: 52 00 00 01 00 00 00 00 00 00 00 set_property r0, r1, @0 ("x"), @0
        \\  84: 4b 00 00 03 00 00 00             get_binding r0, @3 ("o")
        \\  91: 4c 01 00 00 00 00 00 00 00 00 00 get_property r1, r0, @0 ("x"), @0
        \\ 102: 7a 01 00                         return r1
        \\
        \\IR (get x)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..2  ]                       this
        \\  %2: [  2..3  ]                       get_property %1, @0 ("_x")
        \\  %3: [  3..3  ]                       return %2
        \\  %4: [  4..4  ] dead                  return none
        \\
        \\Bytecode (get x)
        \\   0: 42                               push_scope
        \\   1: 1c 00 00                         resolve_this_binding r0
        \\   4: 4c 01 00 00 00 00 00 00 00 00 00 get_property r1, r0, @0 ("_x"), @0
        \\  15: 7a 01 00                         return r1
        \\
        \\IR (set x)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("v")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("v"), %1
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..6  ]                       this
        \\  %5: [  5..6  ]                       get_binding @0 ("v")
        \\  %6: [  6..6  ]                       set_property %4, @1 ("_x"), %5
        \\  %7: [  7..7  ]                       return none
        \\
        \\Bytecode (set x)
        \\   0: 83 00 00 00 00                   get_argument r0, 0
        \\   5: 4f 00 00 00 00                   set_local l0, r0
        \\  10: 42                               push_scope
        \\  11: 1c 00 00                         resolve_this_binding r0
        \\  14: 4a 01 00 00 00                   get_local r1, l0
        \\  19: 52 00 00 01 00 01 00 00 00 00 00 set_property r0, r1, @1 ("_x"), @0
        \\  30: 7a ff ff                         return
        \\
        ,
    },

    // Generator
    .{
        .source =
        \\function* h() {
        \\  yield 4;
        \\  yield 5;
        \\}
        \\function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\  yield* h();
        \\}
        \\function f() {
        \\  var gen = g();
        \\  var sum = 0;
        \\  while (true) {
        \\    var result = gen.next();
        \\    if (result.done) break;
        \\    sum += result.value;
        \\  }
        \\  return sum;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 15 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       get_binding @0 ("f")
        \\  %1: [  1..2  ]                       call %0, none, []
        \\  %2: [  2..2  ]                       return %1
        \\
        \\Bytecode (test)
        \\   0: 4b 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   7: 61 01 00 00 00                   call0 r1, r0
        \\  12: 7a 01 00                         return r1
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       create_var_binding @0 ("gen")
        \\  %1: [  1..1  ]                       create_var_binding @1 ("sum")
        \\  %2: [  2..2  ]                       create_var_binding @2 ("result")
        \\  %3: [  3..3  ]                       push_scope
        \\  %4: [  4..5  ]                       get_binding @3 ("g")
        \\  %5: [  5..6  ]                       call %4, none, []
        \\  %6: [  6..6  ]                       set_binding @0 ("gen"), %5
        \\  %7: [  7..8  ]                       number 0
        \\  %8: [  8..8  ]                       set_binding @1 ("sum"), %7
        \\  %9: [  9..36 ]                       undefined
        \\ %10: [ 10..10 ]                       br %11, %9
        \\ %11: [ 11..38 ]                       label
        \\ %12: [ 12..13 ]                       true
        \\ %13: [ 13..13 ]                       br_cond %12, %14, %37
        \\ %14: [ 14..14 ]                       label
        \\ %15: [ 15..17 ]                       get_binding @0 ("gen")
        \\ %16: [ 16..17 ]                       get_property %15, @4 ("next")
        \\ %17: [ 17..18 ]                       call %16, %15, []
        \\ %18: [ 18..18 ]                       set_binding @2 ("result"), %17
        \\ %19: [ 19..20 ]                       get_binding @2 ("result")
        \\ %20: [ 20..21 ]                       get_property %19, @5 ("done")
        \\ %21: [ 21..22 ]                       to_boolean %20
        \\ %22: [ 22..22 ]                       br_cond %21, %23, %27
        \\ %23: [ 23..23 ]                       label
        \\ %24: [ 24..24 ]                       br %39, %9
        \\ %25: [ 25..26 ] dead                  undefined
        \\ %26: [ 26..26 ] dead                  br %30, %25
        \\ %27: [ 27..27 ]                       label
        \\ %28: [ 28..29 ]                       undefined
        \\ %29: [ 29..29 ]                       br %30, %28
        \\ %30: [ 30..30 ]                       label
        \\ %31: [ 31..34 ]                       get_binding @1 ("sum")
        \\ %32: [ 32..33 ]                       get_binding @2 ("result")
        \\ %33: [ 33..34 ]                       get_property %32, @6 ("value")
        \\ %34: [ 34..35 ]                       add %31, %33
        \\ %35: [ 35..36 ]                       set_binding @1 ("sum"), %34
        \\ %36: [ 36..36 ]                       br %11, %35
        \\ %37: [ 37..37 ]                       label
        \\ %38: [ 38..38 ]                       br %39, %11
        \\ %39: [ 39..39 ]                       label
        \\ %40: [ 40..41 ]                       get_binding @1 ("sum")
        \\ %41: [ 41..41 ]                       return %40
        \\ %42: [ 42..42 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 42                               push_scope
        \\   1: 4b 00 00 03 00 00 00             get_binding r0, @3 ("g")
        \\   8: 61 01 00 00 00                   call0 r1, r0
        \\  13: 4f 00 00 01 00                   set_local l0, r1
        \\  18: 07 00 00 00                      load_number_i8 r0, 0
        \\  22: 4f 01 00 00 00                   set_local l1, r0
        \\  27: 03 00 00                         load_undefined r0
        \\  30: 0c 01 00 00 00                   move r1, r0
        \\  35: 05 02 00                         load_true r2
        \\  38: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\  45: 00 75 00 00 00                   jump 117
        \\  50: 4a 02 00 00 00                   get_local r2, l0
        \\  55: 4c 03 00 02 00 04 00 00 00 00 00 get_property r3, r2, @4 ("next"), @0
        \\  66: 65 04 00 03 00 02 00             call_property0 r4, r3, r2
        \\  73: 4f 02 00 04 00                   set_local l2, r4
        \\  78: 4a 02 00 02 00                   get_local r2, l2
        \\  83: 4c 03 00 02 00 05 00 00 00 01 00 get_property r3, r2, @5 ("done"), @1
        \\  94: 1d 02 00 03 00                   to_boolean r2, r3
        \\  99: 01 02 00 05 00 00 00             jump_if_true r2, 5
        \\ 106: 00 05 00 00 00                   jump 5
        \\ 111: 00 33 00 00 00                   jump 51
        \\ 116: 03 02 00                         load_undefined r2
        \\ 119: 4a 02 00 01 00                   get_local r2, l1
        \\ 124: 4a 03 00 02 00                   get_local r3, l2
        \\ 129: 4c 04 00 03 00 06 00 00 00 02 00 get_property r4, r3, @6 ("value"), @2
        \\ 140: 2b 03 00 02 00 04 00             add r3, r2, r4
        \\ 147: 4f 01 00 03 00                   set_local l1, r3
        \\ 152: 0c 02 00 03 00                   move r2, r3
        \\ 157: 0c 01 00 02 00                   move r1, r2
        \\ 162: 00 7c ff ff ff                   jump -132
        \\ 167: 4a 00 00 01 00                   get_local r0, l1
        \\ 172: 7a 00 00                         return r0
        \\
        \\IR (g)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       number 1
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..7  ]                       number 3
        \\  %7: [  7..7  ]                       yield %6
        \\  %8: [  8..9  ]                       get_binding @0 ("h")
        \\  %9: [  9..10 ]                       call %8, none, []
        \\ %10: [ 10..11 ]                       get_iterator %9
        \\ %11: [ 11..11 ]                       yield_star %10
        \\ %12: [ 12..12 ]                       return none
        \\
        \\Bytecode (g)
        \\   0: 42                               push_scope
        \\   1: 7c ff ff ff ff                   yield
        \\   6: 07 00 00 01                      load_number_i8 r0, 1
        \\  10: 7c 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 02                      load_number_i8 r0, 2
        \\  19: 7c 01 00 00 00                   yield r1, r0
        \\  24: 07 00 00 03                      load_number_i8 r0, 3
        \\  28: 7c 01 00 00 00                   yield r1, r0
        \\  33: 4b 00 00 00 00 00 00             get_binding r0, @0 ("h")
        \\  40: 61 01 00 00 00                   call0 r1, r0
        \\  45: 6f 00 00 01 00                   get_iterator r0, r1
        \\  50: 03 01 00                         load_undefined r1
        \\  53: 7d 01 00 00 00                   yield_star r1, r0
        \\  58: 7a ff ff                         return
        \\
        \\IR (h)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       number 4
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 5
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..6  ]                       return none
        \\
        \\Bytecode (h)
        \\   0: 42                               push_scope
        \\   1: 7c ff ff ff ff                   yield
        \\   6: 07 00 00 04                      load_number_i8 r0, 4
        \\  10: 7c 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 05                      load_number_i8 r0, 5
        \\  19: 7c 01 00 00 00                   yield r1, r0
        \\  24: 7a ff ff                         return
        \\
        ,
    },

    // Async Generator
    .{
        .source =
        \\async function* g() {
        \\  yield 1;
        \\  yield 2;
        \\  yield 3;
        \\}
        \\async function f() {
        \\  var gen = g();
        \\  var a = await gen.next();
        \\  var b = await gen.next();
        \\  var c = await gen.next();
        \\  return a.value + b.value + c.value;
        \\}
        \\f();
        \\
        ,
        .expected_result = .{ .promise = .{ .fulfilled = .{ .number = 6 } } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..1  ]                       get_binding @0 ("f")
        \\  %1: [  1..2  ]                       call %0, none, []
        \\  %2: [  2..2  ]                       return %1
        \\
        \\Bytecode (test)
        \\   0: 4b 00 00 00 00 00 00             get_binding r0, @0 ("f")
        \\   7: 61 01 00 00 00                   call0 r1, r0
        \\  12: 7a 01 00                         return r1
        \\
        \\IR (f)
        \\  %0: [  0..0  ]                       create_var_binding @0 ("gen")
        \\  %1: [  1..1  ]                       create_var_binding @1 ("a")
        \\  %2: [  2..2  ]                       create_var_binding @2 ("b")
        \\  %3: [  3..3  ]                       create_var_binding @3 ("c")
        \\  %4: [  4..4  ]                       push_scope
        \\  %5: [  5..6  ]                       get_binding @4 ("g")
        \\  %6: [  6..7  ]                       call %5, none, []
        \\  %7: [  7..7  ]                       set_binding @0 ("gen"), %6
        \\  %8: [  8..10 ]                       get_binding @0 ("gen")
        \\  %9: [  9..10 ]                       get_property %8, @5 ("next")
        \\ %10: [ 10..11 ]                       call %9, %8, []
        \\ %11: [ 11..12 ]                       await %10
        \\ %12: [ 12..12 ]                       set_binding @1 ("a"), %11
        \\ %13: [ 13..15 ]                       get_binding @0 ("gen")
        \\ %14: [ 14..15 ]                       get_property %13, @5 ("next")
        \\ %15: [ 15..16 ]                       call %14, %13, []
        \\ %16: [ 16..17 ]                       await %15
        \\ %17: [ 17..17 ]                       set_binding @2 ("b"), %16
        \\ %18: [ 18..20 ]                       get_binding @0 ("gen")
        \\ %19: [ 19..20 ]                       get_property %18, @5 ("next")
        \\ %20: [ 20..21 ]                       call %19, %18, []
        \\ %21: [ 21..22 ]                       await %20
        \\ %22: [ 22..22 ]                       set_binding @3 ("c"), %21
        \\ %23: [ 23..24 ]                       get_binding @1 ("a")
        \\ %24: [ 24..27 ]                       get_property %23, @6 ("value")
        \\ %25: [ 25..26 ]                       get_binding @2 ("b")
        \\ %26: [ 26..27 ]                       get_property %25, @6 ("value")
        \\ %27: [ 27..30 ]                       add %24, %26
        \\ %28: [ 28..29 ]                       get_binding @3 ("c")
        \\ %29: [ 29..30 ]                       get_property %28, @6 ("value")
        \\ %30: [ 30..31 ]                       add %27, %29
        \\ %31: [ 31..31 ]                       return %30
        \\ %32: [ 32..32 ] dead                  return none
        \\
        \\Bytecode (f)
        \\   0: 42                               push_scope
        \\   1: 4b 00 00 04 00 00 00             get_binding r0, @4 ("g")
        \\   8: 61 01 00 00 00                   call0 r1, r0
        \\  13: 4f 00 00 01 00                   set_local l0, r1
        \\  18: 4a 00 00 00 00                   get_local r0, l0
        \\  23: 4c 01 00 00 00 05 00 00 00 00 00 get_property r1, r0, @5 ("next"), @0
        \\  34: 65 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  41: 7b 00 00 02 00                   await r0, r2
        \\  46: 4f 01 00 00 00                   set_local l1, r0
        \\  51: 4a 00 00 00 00                   get_local r0, l0
        \\  56: 4c 01 00 00 00 05 00 00 00 01 00 get_property r1, r0, @5 ("next"), @1
        \\  67: 65 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\  74: 7b 00 00 02 00                   await r0, r2
        \\  79: 4f 02 00 00 00                   set_local l2, r0
        \\  84: 4a 00 00 00 00                   get_local r0, l0
        \\  89: 4c 01 00 00 00 05 00 00 00 02 00 get_property r1, r0, @5 ("next"), @2
        \\ 100: 65 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\ 107: 7b 00 00 02 00                   await r0, r2
        \\ 112: 4f 03 00 00 00                   set_local l3, r0
        \\ 117: 4a 00 00 01 00                   get_local r0, l1
        \\ 122: 4c 01 00 00 00 06 00 00 00 03 00 get_property r1, r0, @6 ("value"), @3
        \\ 133: 4a 00 00 02 00                   get_local r0, l2
        \\ 138: 4c 02 00 00 00 06 00 00 00 04 00 get_property r2, r0, @6 ("value"), @4
        \\ 149: 2b 00 00 01 00 02 00             add r0, r1, r2
        \\ 156: 4a 01 00 03 00                   get_local r1, l3
        \\ 161: 4c 02 00 01 00 06 00 00 00 05 00 get_property r2, r1, @6 ("value"), @5
        \\ 172: 2b 01 00 00 00 02 00             add r1, r0, r2
        \\ 179: 7a 01 00                         return r1
        \\
        \\IR (g)
        \\  %0: [  0..0  ]                       push_scope
        \\  %1: [  1..1  ]                       yield none
        \\  %2: [  2..3  ]                       number 1
        \\  %3: [  3..3  ]                       yield %2
        \\  %4: [  4..5  ]                       number 2
        \\  %5: [  5..5  ]                       yield %4
        \\  %6: [  6..7  ]                       number 3
        \\  %7: [  7..7  ]                       yield %6
        \\  %8: [  8..8  ]                       return none
        \\
        \\Bytecode (g)
        \\   0: 42                               push_scope
        \\   1: 7c ff ff ff ff                   yield
        \\   6: 07 00 00 01                      load_number_i8 r0, 1
        \\  10: 7c 01 00 00 00                   yield r1, r0
        \\  15: 07 00 00 02                      load_number_i8 r0, 2
        \\  19: 7c 01 00 00 00                   yield r1, r0
        \\  24: 07 00 00 03                      load_number_i8 r0, 3
        \\  28: 7c 01 00 00 00                   yield r1, r0
        \\  33: 7a ff ff                         return
        \\
        ,
    },

    // Classes
    .{
        .source =
        \\class Foo {
        \\  #x;
        \\  constructor(x) { this.#x = x; }
        \\  getX() { return this.#x; }
        \\}
        \\class Bar extends Foo {
        \\  constructor(x) { super(x); }
        \\  getX() { return super.getX() + 1; }
        \\}
        \\var bar = new Bar(42);
        \\bar.getX();
        \\
        ,
        .expected_result = .{ .value = .{ .number = 43 } },
        .expected_output =
        \\IR (test)
        \\  %0: [  0..0  ]                       push_private_scope
        \\  %1: [  1..3  ]                       create_private_element @1 ("x")
        \\  %2: [  2..3  ]                       string @2 ("getX")
        \\  %3: [  3..5  ]                       create_class @0, none, [%1, %2]
        \\  %4: [  4..4  ]                       pop_private_scope
        \\  %5: [  5..5  ]                       initialize_binding @0 ("Foo"), %3
        \\  %6: [  6..9  ]                       get_binding @0 ("Foo")
        \\  %7: [  7..7  ]                       push_private_scope
        \\  %8: [  8..9  ]                       string @2 ("getX")
        \\  %9: [  9..11 ]                       create_class @1, %6, [%8]
        \\ %10: [ 10..10 ]                       pop_private_scope
        \\ %11: [ 11..11 ]                       initialize_binding @3 ("Bar"), %9
        \\ %12: [ 12..14 ]                       get_binding @3 ("Bar")
        \\ %13: [ 13..14 ]                       number 42
        \\ %14: [ 14..15 ]                       construct %12, [%13]
        \\ %15: [ 15..15 ]                       set_binding @4 ("bar"), %14
        \\ %16: [ 16..18 ]                       get_binding @4 ("bar")
        \\ %17: [ 17..18 ]                       get_property %16, @2 ("getX")
        \\ %18: [ 18..19 ]                       call %17, %16, []
        \\ %19: [ 19..19 ]                       return %18
        \\
        \\Bytecode (test)
        \\   0: 8d                               push_private_scope
        \\   1: 8f 00 00 01 00 00 00             create_private_element r0, @1 ("x")
        \\   8: 0a 01 00 02 00 00 00             load_string r1, @2 ("getX")
        \\  15: 7f 02 00 00 00                   create_class r2, @0
        \\  20: 8e                               pop_private_scope
        \\  21: 49 00 00 00 00 02 00             initialize_binding @0 ("Foo"), r2
        \\  28: 4b 00 00 00 00 00 00             get_binding r0, @0 ("Foo")
        \\  35: 8d                               push_private_scope
        \\  36: 0a 01 00 02 00 00 00             load_string r1, @2 ("getX")
        \\  43: 7f 02 00 01 00                   create_class r2, @1
        \\  48: 8e                               pop_private_scope
        \\  49: 49 03 00 00 00 02 00             initialize_binding @3 ("Bar"), r2
        \\  56: 4b 00 00 03 00 00 00             get_binding r0, @3 ("Bar")
        \\  63: 07 01 00 2a                      load_number_i8 r1, 42
        \\  67: 6c 02 00 00 00 01 00             construct1 r2, r0, r1
        \\  74: 50 04 00 00 00 02 00             set_binding @4 ("bar"), r2
        \\  81: 4b 00 00 04 00 00 00             get_binding r0, @4 ("bar")
        \\  88: 4c 01 00 00 00 02 00 00 00 00 00 get_property r1, r0, @2 ("getX"), @0
        \\  99: 65 02 00 01 00 00 00             call_property0 r2, r1, r0
        \\ 106: 7a 02 00                         return r2
        \\
        \\IR (Bar)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("x")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("x"), %1
        \\  %3: [  3..4  ]                       get_binding @0 ("x")
        \\  %4: [  4..4  ]                       super_call [%3]
        \\  %5: [  5..5  ]                       return none
        \\
        \\Bytecode (Bar)
        \\   0: 83 00 00 00 00                   get_argument r0, 0
        \\   5: 4f 00 00 00 00                   set_local l0, r0
        \\  10: 4a 00 00 00 00                   get_local r0, l0
        \\  15: 0d 02 00 00 00 00 00             create_array r2, 0
        \\  22: 0e 02 00 00 00                   array_push r2, r0
        \\  27: 86 01 00 02 00                   super_call r1, r2
        \\  32: 7a ff ff                         return
        \\
        \\IR (Foo)
        \\  %0: [  0..0  ]                       create_mutable_binding @0 ("x")
        \\  %1: [  1..2  ]                       get_argument 0
        \\  %2: [  2..2  ]                       initialize_binding @0 ("x"), %1
        \\  %3: [  3..5  ]                       this
        \\  %4: [  4..5  ]                       get_binding @0 ("x")
        \\  %5: [  5..5  ]                       set_private_element %3, @0 ("x"), %4
        \\  %6: [  6..6  ]                       return none
        \\
        \\Bytecode (Foo)
        \\   0: 83 00 00 00 00                   get_argument r0, 0
        \\   5: 4f 00 00 00 00                   set_local l0, r0
        \\  10: 1c 00 00                         resolve_this_binding r0
        \\  13: 4a 01 00 00 00                   get_local r1, l0
